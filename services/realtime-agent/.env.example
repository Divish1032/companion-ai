AGENT_ENVIRONMENT=local
AGENT_REDIS_URL=redis://localhost:6379/1
AGENT_LIVEKIT_URL=ws://localhost:7880
AGENT_LIVEKIT_API_KEY=devkey
AGENT_LIVEKIT_API_SECRET=secret
AGENT_PERSONA_CONFIG=config/personas/hindi_companion_v1.toml
AGENT_MAX_CONCURRENT_AGENTS=10
AGENT_MAX_AGENT_MEMORY_MB=512
AGENT_MAX_IDLE_SECONDS=120
AGENT_MEMORY_API_BASE_URL=http://localhost:8000
AGENT_ENABLE_MEMORY_PLANNER=false
AGENT_MEMORY_PLANNER_MODEL=Qwen/Qwen3-0.6B
AGENT_MEMORY_PLANNER_TIMEOUT_SECONDS=0.1
AGENT_MEMORY_LOOKUP_TIMEOUT_SECONDS=1.0
AGENT_ENABLE_LIVEKIT_RTC=true
AGENT_ENABLE_FAKE_AUDIO=true
AGENT_FAKE_AUDIO_MS=550
AGENT_LANGUAGE=hi-IN
AGENT_STT_PROVIDER=
# Leave blank to use the language route. Set to `vosk` to use the local
# standalone Vosk adapter, or `sarvam` to override a language route.
AGENT_STT_MODEL=vosk-model-small-hi-0.22
AGENT_VOSK_MODEL_PATH=/models/vosk-model-small-hi-0.22
AGENT_STT_MIN_CONFIDENCE=0.35
AGENT_SARVAM_STT_MODEL=saaras:v3
AGENT_SARVAM_STT_MODE=codemix
AGENT_SARVAM_STT_CHUNK_MS=120
AGENT_SARVAM_STT_RESPONSE_TIMEOUT_SECONDS=5
AGENT_SARVAM_STT_PRICE_PER_HOUR=30
# Real sessions use Sarvam. `mock` is accepted only by non-production tests.
AGENT_LLM_PROVIDER=sarvam
AGENT_LLM_MODEL=sarvam-30b
AGENT_TTS_PROVIDER=
AGENT_TTS_FALLBACK_PROVIDER=
AGENT_TTS_MODEL=bulbul:v3
AGENT_TTS_SPEAKER=shubh
AGENT_TTS_SAMPLE_RATE=24000
AGENT_TTS_TIMEOUT_SECONDS=12
AGENT_TTS_PRICE_PER_10K_CHARS=30
AGENT_KOKORO_BASE_URL=http://localhost:8880/v1
AGENT_KOKORO_MODEL=kokoro
AGENT_KOKORO_FIRST_AUDIO_TIMEOUT_SECONDS=2
AGENT_KOKORO_TOTAL_TIMEOUT_SECONDS=12
AGENT_KOKORO_READINESS_TIMEOUT_SECONDS=30
AGENT_VOICE_CATALOG=config/voices/hindi_v1.toml
# Sprint 8 telemetry is content-free and never participates in the voice path.
AGENT_ENABLE_METRICS_INGEST=false
AGENT_METRICS_INGEST_URL=http://api:8000/v1/telemetry/ingest
AGENT_METRICS_INGEST_TOKEN=
AGENT_SARVAM_API_KEY=
AGENT_SARVAM_BASE_URL=https://api.sarvam.ai/v1
AGENT_SARVAM_TTS_BASE_URL=https://api.sarvam.ai
AGENT_LLM_TIMEOUT_SECONDS=12
AGENT_VAD_PROVIDER=silero
AGENT_VAD_START_THRESHOLD=0.55
AGENT_VAD_END_THRESHOLD=0.35
AGENT_VAD_BARGE_IN_THRESHOLD=0.65
AGENT_VAD_MIN_CONFIRMED_SPEECH_MS=200
AGENT_VAD_PRE_SPEECH_BUFFER_MS=240
AGENT_VAD_ENDPOINT_SILENCE_MS=600
AGENT_VAD_CONTINUATION_SILENCE_MS=1100
AGENT_VAD_COALESCING_SILENCE_MS=1500
AGENT_VAD_FORCED_ENDPOINT_MS=9000
