AGENT_ENVIRONMENT=local
AGENT_REDIS_URL=redis://localhost:6379/1
AGENT_LIVEKIT_URL=ws://localhost:7880
AGENT_LIVEKIT_API_KEY=devkey
AGENT_LIVEKIT_API_SECRET=secret
AGENT_PERSONA_CONFIG=config/personas/hindi_companion_v1.toml
AGENT_MAX_CONCURRENT_AGENTS=10
AGENT_MAX_AGENT_MEMORY_MB=512
AGENT_MAX_IDLE_SECONDS=120
AGENT_ENABLE_LIVEKIT_RTC=true
AGENT_ENABLE_FAKE_AUDIO=true
AGENT_FAKE_AUDIO_MS=550
AGENT_LANGUAGE=hi-IN
AGENT_STT_PROVIDER=
AGENT_STT_MODEL=vosk-model-small-hi-0.22
AGENT_VOSK_MODEL_PATH=/models/vosk-model-small-hi-0.22
AGENT_STT_MIN_CONFIDENCE=0.35
AGENT_LLM_PROVIDER=
AGENT_LLM_MODEL=sarvam-30b
AGENT_SARVAM_API_KEY=
AGENT_SARVAM_BASE_URL=https://api.sarvam.ai/v1
AGENT_LLM_TIMEOUT_SECONDS=12
AGENT_VAD_PROVIDER=silero
AGENT_VAD_START_THRESHOLD=0.55
AGENT_VAD_END_THRESHOLD=0.35
AGENT_VAD_BARGE_IN_THRESHOLD=0.65
AGENT_VAD_MIN_CONFIRMED_SPEECH_MS=200
AGENT_VAD_PRE_SPEECH_BUFFER_MS=240
AGENT_VAD_ENDPOINT_SILENCE_MS=600
AGENT_VAD_CONTINUATION_SILENCE_MS=1100
AGENT_VAD_FORCED_ENDPOINT_MS=9000
