{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-ai/contracts/memory-v3/memory_compile_request.schema.json",
  "title": "MemoryCompileRequestV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "language", "timezone", "now_ms", "turns"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "job_id": {"type": "string", "pattern": "^memory_compile_[A-Za-z0-9_-]{8,160}$"},
    "language": {"type": "string", "minLength": 2, "maxLength": 32},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
    "now_ms": {"type": "integer", "minimum": 0},
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/turn"}
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "role", "text", "status", "created_at_ms"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 1600},
        "status": {"type": "string", "enum": ["final", "final_corrected", "safety_override"]},
        "language": {"type": "string", "maxLength": 32},
        "script": {"type": "string", "enum": ["latin", "devanagari", "mixed", "unknown"]},
        "stt_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "stt_provider": {"type": ["string", "null"], "maxLength": 80},
        "stt_model": {"type": ["string", "null"], "maxLength": 120},
        "created_at_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
