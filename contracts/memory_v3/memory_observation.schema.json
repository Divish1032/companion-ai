{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-ai/contracts/memory-v3/memory_observation.schema.json",
  "title": "MemoryObservationV3",
  "description": "An evidence-backed candidate observation proposed by stateless compute and validated on the phone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "kind",
    "subject",
    "predicate",
    "object",
    "evidence",
    "temporal",
    "epistemic",
    "utility",
    "privacy",
    "proposed_operation"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate_[A-Za-z0-9_-]{8,128}$",
      "description": "Request-local candidate ID; never a database target ID."
    },
    "kind": {
      "type": "string",
      "enum": [
        "profile",
        "relationship",
        "preference",
        "routine",
        "goal",
        "value",
        "boundary",
        "episode",
        "open_thread",
        "assistant_commitment"
      ]
    },
    "subject": {"$ref": "#/$defs/entity_mention"},
    "predicate": {
      "type": "string",
      "enum": [
        "preferred_name",
        "has_relationship",
        "response_language",
        "response_length",
        "support_style",
        "likes",
        "dislikes",
        "avoids_topic",
        "follows_routine",
        "pursues_goal",
        "holds_value",
        "experienced_event",
        "event_outcome",
        "open_thread",
        "assistant_commitment",
        "works_at",
        "profile_association",
        "relationship_association",
        "episode_association",
        "causes_stress"
      ]
    },
    "object": {"$ref": "#/$defs/object_value"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "temporal": {"$ref": "#/$defs/temporal"},
    "epistemic": {"$ref": "#/$defs/epistemic"},
    "affect": {"$ref": "#/$defs/affect"},
    "utility": {"$ref": "#/$defs/utility"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "proposed_operation": {
      "type": "string",
      "const": "ADD",
      "description": "Formation is append-only. Historical mutation belongs to consolidation."
    }
  },
  "$defs": {
    "entity_mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "mention"],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": ["user", "person", "organization", "place", "event", "goal", "preference", "routine", "topic", "value"]
        },
        "mention": {"type": "string", "minLength": 1, "maxLength": 120},
        "relationship_hint": {"type": "string", "maxLength": 80}
      }
    },
    "object_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "normalized_value": {
          "type": ["string", "number", "boolean", "null"],
          "description": "Optional simple normalized value; original evidence remains authoritative."
        },
        "target_entity": {"$ref": "#/$defs/entity_mention"},
        "user_assessment": {"type": "string", "maxLength": 240}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "role", "fragment"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "fragment": {"type": "string", "minLength": 1, "maxLength": 500},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1}
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolution_confidence"],
      "properties": {
        "status": {"type": "string", "enum": ["current", "past", "future", "uncertain"]},
        "event_start_at_ms": {"type": ["integer", "null"], "minimum": 0},
        "event_end_at_ms": {"type": ["integer", "null"], "minimum": 0},
        "raw_expression": {"type": ["string", "null"], "maxLength": 120},
        "resolution_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "epistemic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicitness", "confidence", "negated", "hypothetical", "quoted"],
      "properties": {
        "explicitness": {"type": "string", "enum": ["explicit", "implied", "assistant_only"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "negated": {"type": "boolean"},
        "hypothetical": {"type": "boolean"},
        "quoted": {"type": "boolean"}
      }
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emotion", "valence", "arousal", "intensity", "confidence"],
      "properties": {
        "emotion": {
          "type": "string",
          "enum": ["joy", "sadness", "anger", "fear", "frustration", "loneliness", "anxiety", "shame", "relief", "pride", "excitement", "disappointment", "tiredness", "neutral", "other"]
        },
        "valence": {"type": "number", "minimum": -1, "maximum": 1},
        "arousal": {"type": "number", "minimum": 0, "maximum": 1},
        "intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "target": {"type": ["string", "null"], "maxLength": 160},
        "cause": {"type": ["string", "null"], "maxLength": 240},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["salience", "future_utility", "proactive_allowed", "confirmation_required"],
      "properties": {
        "salience": {"type": "number", "minimum": 0, "maximum": 1},
        "future_utility": {"type": "number", "minimum": 0, "maximum": 1},
        "proactive_allowed": {"type": "boolean"},
        "confirmation_required": {"type": "boolean"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity", "durable_eligibility"],
      "properties": {
        "sensitivity": {"type": "string", "enum": ["normal", "restricted", "forbidden"]},
        "durable_eligibility": {"type": "string", "enum": ["automatic", "explicit_only", "ephemeral", "never"]},
        "reason": {"type": ["string", "null"], "maxLength": 240}
      }
    }
  }
}
