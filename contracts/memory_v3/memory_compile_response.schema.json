{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-ai/contracts/memory-v3/memory_compile_response.schema.json",
  "title": "MemoryCompileResponseV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "contract_version", "candidates", "model"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "job_id": {"type": "string", "pattern": "^memory_compile_[A-Za-z0-9_-]{8,160}$"},
    "contract_version": {"type": "string", "const": "memory_compile_v3_1"},
    "candidates": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "memory_observation.schema.json"}
    },
    "no_memory_reason": {"type": ["string", "null"], "maxLength": 240},
    "model": {"$ref": "#/$defs/model"}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version", "usage_source", "input_tokens", "output_tokens"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 80},
        "model": {"type": "string", "minLength": 1, "maxLength": 160},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "usage_source": {"type": "string", "enum": ["provider_reported", "estimated", "unknown"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_micro_inr": {"type": "integer", "minimum": 0}
      }
    }
  }
}
