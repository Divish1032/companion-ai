{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-ai/evaluation/memory-v3/compiler_freeze.schema.json",
  "title": "MemoryV3CompilerFreeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "freeze_id", "status", "created_at", "runtime_enabled", "artifacts", "notes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "freeze_id": {"type": "string", "pattern": "^task3_1_freeze_[a-z0-9_]+$"},
    "status": {"type": "string", "enum": ["candidate", "qualified", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "runtime_enabled": {"type": "boolean", "const": false},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"type": "string", "enum": ["compiler", "contract", "constructor", "admission", "evaluation"]}
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
