{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion-ai/evaluation/memory-v3/baseline_report.schema.json",
  "title": "MemoryV3Task1BaselineReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "run", "summary", "scenarios"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "contract_version": {"type": "string", "const": "memory_v3_baseline_report_v1"},
    "run": {"$ref": "#/$defs/run"},
    "summary": {"$ref": "#/$defs/summary"},
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/scenario_result"}
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "generated_at",
        "git_revision",
        "git_dirty",
        "fixture_catalog",
        "fixture_sha256",
        "persona_file",
        "persona_sha256",
        "provider",
        "model",
        "temperature",
        "max_output_chars",
        "v2_probe_status"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^memory_v3_baseline_[0-9]{8}T[0-9]{6}Z$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "git_revision": {"type": "string", "minLength": 1, "maxLength": 80},
        "git_dirty": {"type": "boolean"},
        "fixture_catalog": {"type": "string", "minLength": 1, "maxLength": 300},
        "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "persona_file": {"type": "string", "minLength": 1, "maxLength": 300},
        "persona_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider": {"type": "string", "enum": ["none", "sarvam"]},
        "model": {"type": ["string", "null"], "maxLength": 160},
        "temperature": {"type": ["number", "string", "null"]},
        "max_output_chars": {"type": "integer", "minimum": 1, "maximum": 2000},
        "v2_probe_status": {"type": "string", "enum": ["completed", "failed", "skipped"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_count",
        "query_count",
        "response_evaluation_query_count",
        "prompt_arm_count",
        "response_arm_count",
        "language_review_pending",
        "protected_scenarios",
        "quality_claim_allowed",
        "v2_baseline"
      ],
      "properties": {
        "scenario_count": {"type": "integer", "minimum": 20, "maximum": 30},
        "query_count": {"type": "integer", "minimum": 20},
        "response_evaluation_query_count": {"type": "integer", "minimum": 0},
        "prompt_arm_count": {"type": "integer", "minimum": 0},
        "response_arm_count": {"type": "integer", "minimum": 0},
        "language_review_pending": {"type": "integer", "minimum": 0},
        "protected_scenarios": {"type": "integer", "minimum": 0},
        "quality_claim_allowed": {"type": "boolean", "const": false},
        "v2_baseline": {"$ref": "#/$defs/v2_baseline"}
      }
    },
    "v2_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_required_queries", "reached_response_boundary", "formation_or_admission_gaps", "retrieval_gaps", "correct_abstentions", "false_positives", "safety_bypasses", "probe_failures"],
      "properties": {
        "memory_required_queries": {"type": "integer", "minimum": 0},
        "reached_response_boundary": {"type": "integer", "minimum": 0},
        "formation_or_admission_gaps": {"type": "integer", "minimum": 0},
        "retrieval_gaps": {"type": "integer", "minimum": 0},
        "correct_abstentions": {"type": "integer", "minimum": 0},
        "false_positives": {"type": "integer", "minimum": 0},
        "safety_bypasses": {"type": "integer", "minimum": 0},
        "probe_failures": {"type": "integer", "minimum": 0}
      }
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "protection", "priority", "v2_probe_error", "queries"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]+_v3$"},
        "protection": {"type": "string", "enum": ["review_candidate", "protected"]},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "v2_probe_error": {"type": ["string", "null"], "maxLength": 500},
        "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query_result"}}
      }
    },
    "query_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "response_evaluation", "v2_retrieval", "v2_diagnosis", "arms"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^query_[a-z0-9_]+$"},
        "response_evaluation": {"type": "boolean"},
        "v2_retrieval": {"$ref": "#/$defs/v2_retrieval"},
        "v2_diagnosis": {"$ref": "#/$defs/v2_diagnosis"},
        "arms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/arm"}
        }
      }
    },
    "v2_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "latency_ms", "memory_blocks", "stored_memory_blocks", "state_snapshot", "response_directive", "state_facts", "policy_card", "semantic_resolved", "error"],
      "properties": {
        "status": {"type": "string", "enum": ["completed", "failed", "skipped"]},
        "latency_ms": {"type": "integer", "minimum": 0},
        "memory_blocks": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/memory_block"}},
        "stored_memory_blocks": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/memory_block"}},
        "state_snapshot": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/state_item"}},
        "response_directive": {"type": ["string", "null"], "maxLength": 80},
        "state_facts": {"type": "array", "maxItems": 12, "items": {"type": "object"}},
        "policy_card": {"type": "object"},
        "semantic_resolved": {"type": "boolean"},
        "error": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "state_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_key", "value", "category"],
      "properties": {
        "state_key": {"type": "string", "maxLength": 200},
        "value": {},
        "category": {"type": "string", "maxLength": 80}
      }
    },
    "v2_diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_memory_needed", "evidence_present_in_v2_storage", "memory_reached_response_boundary", "decision_correct", "first_causal_stage"],
      "properties": {
        "expected_memory_needed": {"type": "boolean"},
        "evidence_present_in_v2_storage": {"type": "boolean"},
        "memory_reached_response_boundary": {"type": "boolean"},
        "decision_correct": {"type": "boolean"},
        "first_causal_stage": {"type": "string", "enum": ["formation_or_admission", "retrieval", "reached_response_boundary", "correct_abstention", "false_positive", "safety_bypass", "probe_failed"]}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "messages",
        "diagnostics",
        "intended_memory",
        "response_status",
        "response",
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "usage_source",
        "error"
      ],
      "properties": {
        "arm_id": {"type": "string", "enum": ["no_memory", "v2", "oracle"]},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "diagnostics": {"type": "object"},
        "intended_memory": {"type": "array", "maxItems": 8, "items": {"type": "object"}},
        "response_status": {"type": "string", "enum": ["prompts_only", "completed", "failed", "not_selected", "direct_response", "safety_override"]},
        "response": {"type": ["string", "null"], "maxLength": 2000},
        "latency_ms": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "usage_source": {"type": "string", "enum": ["provider_reported", "estimated", "unknown", "not_applicable"]},
        "error": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 10000}
      }
    },
    "memory_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "kind",
        "label",
        "content",
        "canonical_text",
        "source_turn_ids",
        "source_role",
        "transcript_status",
        "stt_confidence",
        "created_at_ms",
        "updated_at_ms",
        "last_used_at_ms",
        "confidence_score",
        "importance_score",
        "recurrence_count",
        "sensitivity",
        "temporal_status",
        "receipt_state",
        "evidence_summary"
      ],
      "properties": {
        "memory_id": {"type": "string", "maxLength": 160},
        "kind": {"type": "string", "maxLength": 64},
        "label": {"type": "string", "maxLength": 80},
        "content": {"type": "string", "maxLength": 800},
        "canonical_text": {"type": "string", "maxLength": 800},
        "source_turn_ids": {"type": "array", "items": {"type": "string", "maxLength": 128}},
        "source_role": {"type": "string", "maxLength": 32},
        "transcript_status": {"type": "string", "maxLength": 128},
        "stt_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "created_at_ms": {"type": "integer", "minimum": 0},
        "updated_at_ms": {"type": "integer", "minimum": 0},
        "last_used_at_ms": {"type": ["integer", "null"], "minimum": 0},
        "confidence_score": {"type": "number", "minimum": 0, "maximum": 1},
        "importance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "recurrence_count": {"type": "integer", "minimum": 0},
        "sensitivity": {"type": "string", "maxLength": 64},
        "temporal_status": {"type": "string", "maxLength": 64},
        "receipt_state": {"type": "string", "maxLength": 64},
        "evidence_summary": {"type": "string", "maxLength": 500}
      }
    }
  }
}
