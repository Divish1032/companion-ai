# Rendered on the host by scripts/render-config.sh. Do not place secrets here.
port: 7880
log_level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  # Azure NAT maps this fixed public IP to the host. Pinning it prevents
  # Docker bridge addresses from being advertised as WebRTC candidates.
  use_external_ip: false
  node_ip: ${LIVEKIT_NODE_IP}

redis:
  address: 127.0.0.1:6379

keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

# LiveKit's embedded TURN server is used intentionally. It supplies short-lived,
# authenticated credentials through the signaling protocol to the Flutter SDK.
turn:
  enabled: true
  domain: ${DEPLOY_DOMAIN}
  udp_port: 3478
  tls_port: 5349
  relay_range_start: 40000
  relay_range_end: 40100
  cert_file: /certs/live/${DEPLOY_DOMAIN}/fullchain.pem
  key_file: /certs/live/${DEPLOY_DOMAIN}/privkey.pem
