# Copy this file to /opt/companion/runtime/production.env on the host.
# It is intentionally not a source-tree .env and must be mode 0600.

# A DNS name pointing at the VM public IP. Do not use a bare IP address.
DEPLOY_DOMAIN=companion.example.com
ACME_EMAIL=ops@example.com
RUNTIME_ROOT=/opt/companion/runtime

# Generate these on the host; never retain the generated values in Git.
LIVEKIT_API_KEY=companion
LIVEKIT_API_SECRET=
API_TELEMETRY_INGEST_TOKEN=

# Required only after accepting the gated EmbeddingGemma terms on Hugging Face.
# Keep empty until the artifact is explicitly prepared.
HF_TOKEN=

# Optional Sarvam fallback. Keep empty when testing local Vosk + Kokoro only.
AGENT_SARVAM_API_KEY=
