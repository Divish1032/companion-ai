# This file supplies Docker Compose substitutions and realtime-agent overrides.
# Flutter reads API_BASE_URL only through --dart-define, not from this file.

# Values returned by the API to a local LiveKit client.
# These are LiveKit development credentials, not production secrets.
API_LIVEKIT_URL=ws://localhost:7880
API_LIVEKIT_API_KEY=devkey
API_LIVEKIT_API_SECRET=secret

# Set to the host LAN IPv4 for physical-device Docker testing, for example
# LIVEKIT_NODE_IP=192.168.1.5. Do not use the localhost default on a phone.
LIVEKIT_NODE_IP=
AGENT_LIVEKIT_API_KEY=devkey
AGENT_LIVEKIT_API_SECRET=secret

# Used only with `docker compose --profile telemetry` in local development.
POSTGRES_TELEMETRY_PASSWORD=local-dev-only

# Optional stateless API model services. Keep disabled unless their artifacts
# and/or provider key have been prepared locally.
API_ENABLE_MEMORY_EMBEDDINGS=false
API_MEMORY_EMBEDDING_MODEL=google/embeddinggemma-300m
API_MEMORY_EMBEDDING_REVISION=57c266a740f537b4dc058e1b0cda161fd15afa75
API_MEMORY_EMBEDDING_DIMENSION=768
API_MEMORY_EMBEDDING_BACKEND=onnx
API_MEMORY_EMBEDDING_MODEL_PATH=/models/huggingface/embeddinggemma-onnx-fp32-r57c266a7
API_EMBEDDING_TIMEOUT_SECONDS=1.0
API_ENABLE_MEMORY_RERANKER=false
API_MEMORY_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
API_RERANKER_TIMEOUT_SECONDS=0.12
API_ENABLE_MEMORY_PLANNER=false
API_MEMORY_PLANNER_MODEL=Qwen/Qwen3-0.6B
API_PLANNER_TIMEOUT_SECONDS=0.1
API_ENABLE_MEMORY_EXTRACTION=false
API_MEMORY_EXTRACTION_BASE_URL=https://api.sarvam.ai/v1
API_MEMORY_EXTRACTION_API_KEY=
API_MEMORY_EXTRACTION_MODEL=sarvam-30b
API_MEMORY_EXTRACTION_TIMEOUT_SECONDS=20
API_ENABLE_MEMORY_V3_COMPILER=false
# Task 3 stateless compiler. Keep disabled until the configured model passes
# the redacted Memory V3 formation benchmark and current provider behavior is
# verified. Never commit the key.
API_MEMORY_V3_COMPILER_BASE_URL=https://api.sarvam.ai/v1
API_MEMORY_V3_COMPILER_API_KEY=
API_MEMORY_V3_COMPILER_MODEL=sarvam-30b
API_MEMORY_V3_COMPILER_TIMEOUT_SECONDS=20
API_MEMORY_V3_COMPILER_REQUEST_PROFILE=openai_json_schema
# Evaluation-only DeepSeek credential. Keep the V3 runtime disabled until its
# model passes the full formation gate; never commit a real key.
DEEPSEEK_API_KEY=
API_MEMORY_JUDGE_INPUT_MICRO_INR_PER_MILLION_TOKENS=0
API_MEMORY_JUDGE_OUTPUT_MICRO_INR_PER_MILLION_TOKENS=0
API_TELEMETRY_STORE_PATH=/data/companion_telemetry.sqlite
API_TELEMETRY_INGEST_TOKEN=
# Accept the gated EmbeddingGemma licence in Hugging Face first, then set a
# read-only token locally. Never commit a real token.
HF_TOKEN=

# Realtime-agent configuration. Conversational inference always uses Sarvam;
# add AGENT_SARVAM_API_KEY before running a real voice session.
AGENT_MAX_CONCURRENT_AGENTS=10
AGENT_MAX_IDLE_SECONDS=120
AGENT_MEMORY_API_BASE_URL=http://localhost:8000
AGENT_ENABLE_MEMORY_PLANNER=false
AGENT_MEMORY_PLANNER_MODEL=Qwen/Qwen3-0.6B
AGENT_MEMORY_PLANNER_TIMEOUT_SECONDS=0.1
AGENT_MEMORY_LOOKUP_TIMEOUT_SECONDS=1.0
AGENT_ENABLE_FAKE_AUDIO=true
AGENT_ENABLE_METRICS_INGEST=false
AGENT_LANGUAGE=hi-IN
AGENT_STT_PROVIDER=
# Leave blank to use the language route. Set to `vosk` for local standalone
# STT or `sarvam` to override a language route.
AGENT_STT_MODEL=vosk-model-small-hi-0.22
AGENT_VOSK_MODEL_PATH=/models/vosk-model-small-hi-0.22
AGENT_STT_MIN_CONFIDENCE=0.35
AGENT_SARVAM_STT_MODEL=saaras:v3
AGENT_SARVAM_STT_MODE=codemix
AGENT_SARVAM_STT_CHUNK_MS=120
AGENT_SARVAM_STT_RESPONSE_TIMEOUT_SECONDS=5
AGENT_SARVAM_STT_PRICE_PER_HOUR=30
AGENT_LLM_PROVIDER=sarvam
AGENT_LLM_MODEL=sarvam-30b
AGENT_TTS_PROVIDER=
AGENT_TTS_MODEL=bulbul:v3
AGENT_TTS_SPEAKER=shubh
AGENT_TTS_SAMPLE_RATE=24000
AGENT_TTS_TIMEOUT_SECONDS=12
AGENT_TTS_PRICE_PER_10K_CHARS=30
AGENT_SARVAM_API_KEY=
AGENT_SARVAM_BASE_URL=https://api.sarvam.ai/v1
AGENT_SARVAM_TTS_BASE_URL=https://api.sarvam.ai
